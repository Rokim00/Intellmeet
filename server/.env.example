# ==========================================
# Environment Configuration Template
# NOTE: JWT secrets and the Mongo URI are NOT stored here in Docker runs.
# They are mounted as files from server/secrets/ (see secrets/README.md).
# For local non-Docker development you can still set them directly below.
# ==========================================

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (e.g., http://localhost:5173,http://localhost:3000)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# JWT Secrets & Expiry — REQUIRED, no defaults exist in code
# Generate with: node server/scripts/generate-secrets.mjs
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# File-based secret overrides (Docker / Kubernetes mount these paths)
# JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access_secret
# JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret
# MONGO_URI_FILE=/run/secrets/mongo_uri

# MongoDB Connection Options:
# Option A: Local MongoDB Container
# MONGO_URI=mongodb://127.0.0.1:27017/intellmeet

# Option B: MongoDB Atlas Cloud
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.lztu59q.mongodb.net/intellmeet?retryWrites=true&w=majority

# Local AWS Cloud Emulator (Floci on port 4566)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=intellmeet-bucket

