# Environment Configuration Template
# VITE_* values are inlined into the browser bundle at build time.
# Never put a secret here — anything in this file is public.

# API base URL. Use /api/v1 for the Docker nginx proxy, or an absolute URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional S3/media endpoint used for uploads
VITE_S3_ENDPOINT=http://localhost:4566
VITE_S3_BUCKET=intellmeet-bucket
