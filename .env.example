# Copy these files and fill in real values. Never commit the real .env.
# Secrets are intentionally NOT here — Docker mounts them from ./secrets/*.txt

# Ports exposed on the host
CLIENT_PORT=3000
SERVER_PORT=5000
MONGO_EXPRESS_PORT=8081

# Origin allowed by the API CORS policy
CORS_ORIGIN=http://localhost:3000

# Client build-time API base URL (public config, not a secret)
# /api/v1 works through the nginx reverse proxy; use an absolute URL
# (e.g. https://api.example.com/api/v1) when the API is on another host.
VITE_API_BASE_URL=/api/v1

# MongoDB root credentials (created on first container start)
MONGO_ROOT_USER=intellmeet
MONGO_ROOT_PASSWORD=change_me_strong_password

# Token lifetimes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# S3 / media storage (local emulator by default)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=intellmeet-bucket
